<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- A global light source -->
    <light name='directional_light' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- A ground plane -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Own physics settings to speed up simulation -->
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <model name="target">
      <link name="link">
	<collision name="collision1">
          <geometry>
            <polyline>
              <point>0.2 0.2</point>
              <point>0.2 -0.2</point>
              <point>-0.2 -0.2</point>
              <point>-0.2 0.2</point>
              <height>0.001</height>
            </polyline>
          </geometry>
        </collision>
        <visual name="target">
          <geometry>
            <polyline>
              <point>0.2 0.2</point>
              <point>0.2 -0.2</point>
              <point>-0.2 -0.2</point>
              <point>-0.2 0.2</point>
              <height>0.001</height>
            </polyline>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary walls (box visuals for PBR texture support) -->
    <model name="wall1">
      <static>true</static>
      <link name="link">
        <collision name="collision1">
          <geometry>
            <polyline>
              <point>10 10</point>
              <point>11 10</point>
              <point>11 -11</point>
              <point>10 -11</point>
              <height>1</height>
            </polyline>
          </geometry>
        </collision>
        <visual name="wall1">
          <pose>10.5 -0.5 0.5 0 0 0</pose>
          <geometry>
            <box><size>1 21 1</size></box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://textures/vertical_stripes.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
